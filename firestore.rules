rules_version = '2';
// ============================================================================
// Backend validation for ProLift. Firestore is the only backend, so these
// rules ARE the server-side defense: they run on every write regardless of the
// client, so invalid data cannot be persisted even by calling the API directly.
// Field formats mirror src/logic/validation.ts (keep the two in sync).
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // An optional string field: allowed when empty, else must match the regex.
    function optStr(v, re) {
      return v == '' || v.matches(re);
    }

    // ---- Regex fragments (mirror validation.ts) ----
    // phone:   ^[6-9][0-9]{9}$
    // email:   ^\S+@\S+\.\S+$
    // gstin:   ^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][0-9A-Z]Z[0-9A-Z]$
    // pincode: ^[1-9][0-9]{5}$
    // hsn:     ^[0-9]{4,8}$

    function validCustomer(d) {
      return d.companyName is string && d.companyName.size() > 0
        && optStr(d.get('phone', ''), '^[6-9][0-9]{9}$')
        && optStr(d.get('email', ''), '^\\S+@\\S+\\.\\S+$')
        && optStr(d.get('gstin', ''), '^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][0-9A-Z]Z[0-9A-Z]$')
        && optStr(d.get('pincode', ''), '^[1-9][0-9]{5}$');
    }

    function validProduct(d) {
      return d.name is string && d.name.size() > 0
        && d.get('basicPrice', 0) is number && d.get('basicPrice', 0) >= 0
        && d.get('listingPrice', 0) is number && d.get('listingPrice', 0) >= 0
        && d.get('gstRate', 0) is number && d.get('gstRate', 0) >= 0 && d.get('gstRate', 0) <= 100
        && optStr(d.get('hsn', ''), '^[0-9]{4,8}$');
    }

    function validSettings(d) {
      return optStr(d.get('phone', ''), '^[6-9][0-9]{9}$')
        && optStr(d.get('email', ''), '^\\S+@\\S+\\.\\S+$')
        && optStr(d.get('gstin', ''), '^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][0-9A-Z]Z[0-9A-Z]$');
    }

    match /customers/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && validCustomer(request.resource.data);
    }

    match /products/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && validProduct(request.resource.data);
    }

    match /companySettings/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && validSettings(request.resource.data);
    }

    // Quotations bundle already-validated snapshots of customer + items and are
    // written only by the app; guard by auth (nested totals are app-computed).
    match /quotations/{id} {
      allow read, write: if signedIn();
    }

    // Auto-increment counter for quotation numbers.
    match /quotationSequences/{id} {
      allow read, write: if signedIn();
    }
  }
}
